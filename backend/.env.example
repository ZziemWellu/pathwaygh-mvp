# PathwayGH Environment Variables
ENVIRONMENT=development
DEBUG=true

# Database
DATABASE_URL=postgresql+asyncpg://pathwaygh:password@localhost:5432/pathwaygh

# Redis
REDIS_URL=redis://localhost:6379

# Security
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://pathwaygh-frontend.onrender.com

# AI Services
GEMINI_API_KEY=your_gemini_api_key_here
USE_AI_CHATBOT=true

# Email (guardian consent OTP). If SMTP_HOST is unset, codes are logged
# to the server console instead of sent - fine for local dev, not for
# production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@pathwaygh.com

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60
