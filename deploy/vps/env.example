# Names of the variables /etc/pathwaygh/api.env must contain. NO VALUES in this file.
# Copy the values from the Render dashboard (Environment tab), or from your password manager.
# Values never go into git, chat or logs.

DATABASE_URL=            # Neon connection string (rotate the password first)
SECRET_KEY=              # JWT signing key
FRONTEND_URL=            # frontend's exact public address, e.g. https://learninghotspot.africa
GEMINI_API_KEY=
DIGEST_TRIGGER_SECRET=
PAYSTACK_SECRET_KEY=
AFRICAS_TALKING_USERNAME=
AFRICAS_TALKING_API_KEY=
AFRICAS_TALKING_SENDER_ID=
PRACTICE_SMS_INBOUND_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
